# Environment
NODE_ENV=development

# Logger (pino): fatal, error, warn, info, debug, trace.
# Unset: debug in development, info in production.
LOG_LEVEL=debug

# Swagger UI on /docs. Unset: on only for NODE_ENV=development|test.
ENABLE_SWAGGER=

# Server
PORT=3000
# X-Forwarded-For hops trusted for the client IP (the throttler keys on it).
# 0 = no proxy, 1 = behind one nginx (production: 1). Required when NODE_ENV=production.
TRUST_PROXY_HOPS=0
# Route prefix (e.g. v2 → /v2/images). Empty: routes at the root. Also used in
# every URL FileHarbor returns, so served routes and returned URLs always match.
API_PREFIX=
BASE_URL=http://localhost:3000
# Prometheus `GET /metrics` listens here, not on PORT. Internal network only:
# never publish this port on the container and never proxy it through nginx.
METRICS_PORT=9091
# `*` or a comma-separated list of allowed origins. Required when
# NODE_ENV=production (boot fails without it); defaults to `*` otherwise.
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fileharbor?schema=public"
DATABASE_POOL_MAX=20  # pg pool size per instance (pg default 10)

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
# /health/ready reports down when STORAGE_PATH is not writable or has less
# free space than this (MB).
HEALTH_DISK_MIN_FREE_MB=1024

# Image Processing
THUMBNAIL_SIZE=800
ORIGINAL_QUALITY=100
OPTIMIZE_QUALITY=85  # hourly optimize jobs re-encode originals at this quality (uploads use ORIGINAL_QUALITY)
THUMBNAIL_QUALITY=70
# On-demand renders (GET /images/:id resizes, avatar jpeg/png conversion):
# at most RENDER_CONCURRENCY at once, up to RENDER_QUEUE_LIMIT more wait,
# anything past that gets 503.
RENDER_CONCURRENCY=2
RENDER_QUEUE_LIMIT=20

# Video
# Hand video delivery to nginx via X-Accel-Redirect instead of streaming from
# Node. Only enable behind an nginx that declares the `/internal-videos/`
# internal location — anywhere else the response is headers with an empty body
# and players report the file as an unsupported format.
VIDEO_X_ACCEL_REDIRECT=false
# Same for images: requires `location /internal-images/ { internal; alias <STORAGE_PATH>/; }`
IMAGE_X_ACCEL_REDIRECT=false

# Bastion App
BASTION_URL=http://localhost:8080
BASTION_APP_SLUG=fileharbor
# App slugs whose Bastion user tokens the admin API accepts (comma-separated).
# Meridian hosts the FileHarbor console, so its slug must be listed here.
# Leave empty to accept only BASTION_APP_SLUG.
ADMIN_ACCEPTED_APP_SLUGS=fileharbor,meridian
# Service-client key (POST /clients in Bastion). Used only for outgoing calls:
# admin audit events. Leave empty to run without writing audit events.
BASTION_CLIENT_API_KEY=
# Set only if the service client is bound to a single Bastion tenant.
BASTION_TENANT_SLUG=
# How long a fetched JWKS stays cached. A key rotation is picked up before this
# expires anyway: an unknown `kid` triggers one immediate refetch.
BASTION_JWKS_TTL_MS=300000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10


