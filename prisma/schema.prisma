// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Multi-tenant Client
model Client {
  id             String   @id @default(uuid())
  name           String
  apiKey         String   @unique
  domain         String?  @unique
  active         Boolean  @default(true)
  webhookEnabled Boolean  @default(false)
  webhookUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Tinify credentials (optional, can be set per client for image optimization)
  tinifyActive       Boolean @default(false)
  tinifyApiKey       String?
  currentTinifyUsage Int     @default(0) // Track current month's usage for billing purposes
  currentTinifyLimit Int     @default(500) // Monthly compression limit (default: 500 for free tier)

  // Bastion tenant this client is mapped to for self-service (user-JWT) endpoints,
  // e.g. /me/avatar. Bastion tenant slugs are immutable, so this is a safe key.
  // null = no mapping — that tenant has no self-service FileHarbor client (e.g. "personal").
  bastionTenantSlug String? @unique

  // Personal client: owned by one person rather than by a Bastion tenant.
  // Mutually exclusive with bastionTenantSlug (enforced by a CHECK constraint).
  // A personal client is visible in the console only to its owner's identities —
  // fullAccess principals included. The X-API-Key surface is unaffected.
  ownerPrincipalId String?

  // Relations
  creators       Creator[]
  images         Image[]
  avatars        Avatar[]
  albums         Album[]
  tags           Tag[]
  videos         Video[]
  ownerPrincipal AdminPrincipal? @relation(fields: [ownerPrincipalId], references: [id], onDelete: Restrict)

  @@index([ownerPrincipalId])
  @@map("clients")
}

// Creator within a client — owns visual content, never authenticates
model Creator {
  id         String  @id @default(uuid())
  clientId   String
  externalId String // id of this creator in the client's own system
  email      String?
  username   String?

  website String?
  bio     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  images         Image[]
  videos         Video[]
  avatars        Avatar[]
  albums         Album[]
  adminBookmarks AdminCreatorBookmark[]

  @@unique([clientId, externalId])
  @@index([clientId])
  @@index([externalId])
  @@map("creators")
}

// Image entity
model Image {
  id              String    @id @default(uuid())
  clientId        String
  creatorId       String
  originalName    String
  storagePath     String // e.g., storage/domain/images/{imageId}
  format          String // webp, jpeg, png
  width           Int
  height          Int
  size            Int // bytes
  mimeType        String
  isOptimized     Boolean   @default(false)
  optimizedAt     DateTime?
  tinifyOptimized Boolean   @default(false) // Track if image was compressed with Tinify to avoid reprocessing
  isPrivate       Boolean   @default(false)
  views           Int       @default(0)
  downloads       Int       @default(0)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator         Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  albumItems      AlbumItem[]
  imageTags       ImageTag[]
  shareLinks      ImageShareLink[]
  albumCoverImage Album[]              @relation("AlbumCoverImage")
  adminBookmarks  AdminImageBookmark[]

  @@index([clientId])
  @@index([creatorId])
  @@index([isOptimized])
  @@index([isPrivate])
  @@map("images")
}

// Client-scoped tag entity
model Tag {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  imageTags ImageTag[]
  videoTags VideoTag[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([name])
  @@map("tags")
}

// Many-to-many relationship between Image and Tag
model ImageTag {
  imageId   String
  tagId     String
  createdAt DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId])
  @@map("image_tags")
}

// Video entity
model Video {
  id           String   @id @default(uuid())
  clientId     String
  creatorId    String
  originalName String
  storagePath  String
  mimeType     String
  size         Int
  duration     Float?
  width        Int?
  height       Int?
  isPrivate    Boolean  @default(false)
  views        Int      @default(0)
  downloads    Int      @default(0)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator        Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  videoTags      VideoTag[]
  adminBookmarks AdminVideoBookmark[]
  albumItems     AlbumItem[]

  @@index([clientId])
  @@index([creatorId])
  @@index([clientId, creatorId])
  @@index([isPrivate])
  @@map("videos")
}

// Many-to-many relationship between Video and Tag
model VideoTag {
  videoId   String
  tagId     String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
  @@map("video_tags")
}

// Admin personal bookmark for a video (see AdminImageBookmark for `actorId`)
model AdminVideoBookmark {
  id        String   @id @default(uuid())
  actorId   String
  videoId   String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([actorId, videoId])
  @@index([actorId])
  @@index([videoId])
  @@map("admin_video_bookmarks")
}

// Avatar entity - one active per creator per client
model Avatar {
  id          String    @id @default(uuid())
  clientId    String
  creatorId   String
  storagePath String // e.g., storage/domain/avatars/{creatorId}
  format      String
  width       Int
  height      Int
  size        Int
  mimeType    String
  isOptimized Boolean   @default(false)
  optimizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([clientId, creatorId]) // Only one active avatar per creator
  @@index([clientId])
  @@index([creatorId])
  @@map("avatars")
}

// Album entity
model Album {
  id              String   @id @default(uuid())
  clientId        String
  creatorId       String
  externalAlbumId String? // id of this creator in the client's own system
  name            String
  description     String?
  isPublic        Boolean  @default(false)
  coverImageId    String? // Reference to the cover image
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  coverImage  Image?       @relation("AlbumCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  albumItems  AlbumItem[]
  albumTokens AlbumToken[]

  @@unique([clientId, externalAlbumId])
  @@index([clientId])
  @@index([creatorId])
  @@index([isPublic])
  @@index([coverImageId])
  @@map("albums")
}

enum AlbumResourceType {
  IMAGE
  VIDEO
}

// Many-to-many between Album and Image/Video (mixed)
model AlbumItem {
  id           String            @id @default(uuid())
  albumId      String
  imageId      String?
  videoId      String?
  resourceType AlbumResourceType
  order        Int               @default(0)
  addedAt      DateTime          @default(now())

  album Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  image Image? @relation(fields: [imageId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([albumId, imageId])
  @@unique([albumId, videoId])
  @@index([albumId, order])
  @@index([albumId, resourceType])
  @@map("album_items")
}

// Token for private album access
model AlbumToken {
  id        String    @id @default(uuid())
  albumId   String
  token     String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([token])
  @@map("album_tokens")
}

// A person who needs more than their own tenant, or who owns personal clients.
//
// This is NOT a mirror of Bastion's users: a row exists only for the exceptions.
// Whoever has no row is not rejected — they are simply scoped to the tenant in
// their token. Roles and credentials stay entirely in Bastion.
//
// Rows are provisioned by hand (SQL/seed): the service exposes no endpoint for
// them, which keeps the privilege surface off the network.
model AdminPrincipal {
  id         String   @id @default(uuid())
  label      String // human-readable only, e.g. "andrea" — never used for matching
  fullAccess Boolean  @default(false) // sees every client except other principals' personal ones
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  identities   AdminIdentity[]
  ownedClients Client[]

  @@map("admin_principals")
}

// One Bastion user (a `sub`) belonging to a principal.
//
// Bastion users are tenant-scoped: the same person has a different `sub` in each
// tenant. Linking them here is what lets one person carry the same access — and
// the same personal clients — whichever tenant they sign in through.
model AdminIdentity {
  id            String   @id @default(uuid())
  principalId   String
  bastionUserId String   @unique // the `sub` claim, unique per tenant
  tenantSlug    String // documentation only; matching is always on bastionUserId
  createdAt     DateTime @default(now())

  principal AdminPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([principalId, tenantSlug])
  @@index([principalId])
  @@map("admin_identities")
}

// Admin personal bookmark for an image.
// `actorId` is the principal id when the caller has one, otherwise `sub:<sub>` —
// so a linked person keeps one set of bookmarks across tenants.
model AdminImageBookmark {
  id        String   @id @default(uuid())
  actorId   String
  imageId   String
  createdAt DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([actorId, imageId])
  @@index([actorId])
  @@index([imageId])
  @@map("admin_image_bookmarks")
}

// Admin personal bookmark for a creator
model AdminCreatorBookmark {
  id        String   @id @default(uuid())
  actorId   String
  creatorId String
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([actorId, creatorId])
  @@index([actorId])
  @@index([creatorId])
  @@map("admin_creator_bookmarks")
}

// Token for private image sharing
model ImageShareLink {
  id        String    @id @default(uuid())
  imageId   String
  readToken String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  // Relations
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([readToken])
  @@map("image_share_links")
}
